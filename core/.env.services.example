# The client ids and secrets Knode's connectors sign in with, for developer builds.
# Copy this file to core/.env.services (ignored by git, never committed) and fill in what you
# have; leave the rest empty. The Mac build scripts load it; for plain cargo run
#
#     . ../scripts/load-service-clients.sh && cargo build
#
# A variable set in the environment wins over this file, and every one can also be set when
# Knode Service starts, which wins over the built-in value. Release builds take them from
# GitHub Actions secrets of the same names. Where each value comes from: handbook,
# 07-releasing.md, "Service registrations".

# Gmail, Sign in with Google: Google Cloud project "Knode" > Clients > Desktop app.
KNODE_GOOGLE_CLIENT_ID=
KNODE_GOOGLE_CLIENT_SECRET=

# Telegram: my.telegram.org > API development tools.
KNODE_TELEGRAM_API_ID=
KNODE_TELEGRAM_API_HASH=

# Slack: api.slack.com/apps > Knode > Basic Information > App Credentials > Client ID.
# Slack's client secret is not needed: the connector signs in with PKCE.
KNODE_SLACK_CLIENT_ID=
# "marketplace" once the app is in the Slack Marketplace; empty until then.
KNODE_SLACK_LIMITS=
